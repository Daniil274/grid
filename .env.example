# Grid environment. Copy to .env and fill in what your configs use.

# Model providers: the shipped routing.yaml and example systems use these two.
OPENCODE_API_KEY=your_opencode_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
# Only the coordinator-pipeline example asks for it.
# OPENAI_API_KEY=your_openai_api_key_here

# Plans (docs/plans-and-budgets.md): a key per pool named under `pools` in the catalog,
# so each plan's spend can be capped at the provider on its own.
# OPENROUTER_API_KEY_FRIENDS=
# OPENROUTER_API_KEY_STARTER=
# Seals the keys users store for themselves (python -m web_chat.vault new-key). Keep it
# apart from backups of the accounts database; comma-separate several to rotate.
# GRID_SECRETS_KEY=

# Web search (web_search): a SearXNG instance. docker compose sets it for the
# server image; locally: docker compose -f searxng/docker-compose.yml up -d
# SEARXNG_URL=http://localhost:8080
# How many web_search requests reach SearXNG at once (a burst gets the engines to rate limit the host)
# SEARXNG_MAX_CONCURRENCY=3

# Tracing (core/tracing/config.py): console (default, console + file), file,
# http or disabled.
# GRID_TRACING_TYPE=console
# GRID_TRACING_LEVEL=INFO
# GRID_TRACING_FILE=traces/traces.jsonl
# GRID_TRACING_ENDPOINT=http://localhost:8080/ingest
# GRID_TRACING_TIMEOUT=0.1
# The run timeline (grid-timeline) records every run unless turned off.
# GRID_TIMELINE_ENABLED=true

# Reviews of agent answers: send proposals to the evolution loop (grid-control).
# The task token opens only the controller's task routes; see docs/evolution-setup.md.
# GRID_CONTROL_URL=http://127.0.0.1:8010
# GRID_CONTROL_TASK_TOKEN=

# Optional: local proxy for Docker, npm, npx, and outbound HTTP clients;
# forwarded into users' containers as well.
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
# ALL_PROXY=socks5://127.0.0.1:10808
# NO_PROXY=127.0.0.1,localhost
