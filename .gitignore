# Dependency lockfiles are source. Ignore only a root-level lock if one is generated locally.
/package-lock.json

# Local agent/editor state at repo root only.
# Example-local instructions (.agents, .codex, .cursor/rules) stay committable.
/.kilo/
/.cursor/
/.claude/
/.codex/

# Runtime artifacts under examples
examples/*/runs/
examples/*/.beads/
examples/*/.claude/
