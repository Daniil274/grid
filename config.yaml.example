# Full AI system configuration
# Providers -> Models -> Tools -> Agents

# Global settings
settings:
  default_agent: "coordinator"
  max_history: 50
  max_turns: 100  # Increase turn limit for agents
  agent_timeout: 300  # Agent execution timeout in seconds (5 minutes)
  debug: false
  mcp_enabled: true
  # Path settings
  working_directory: "C:/Users/daniil/Documents/agents"  # Default working directory
  config_directory: "."   # Configuration directory
  logs_directory: "C:/Users/daniil/Documents/agents/logs"
  allow_path_override: true  # Allow path override on launch
  # Logging settings
  agent_logging:
    enabled: true
    level: "full"  # basic, detailed, full
    save_prompts: true
    save_conversations: true
    save_executions: true
    # Common tool usage rules (added to each agent once)
    tools_common_rules: |
      Always perform file operations through tools and return their results.
      Do not claim file creation/modification without invoking a tool.
  # Image processing settings
  image_processing:
    enabled: true
    auto_resize: true  # Automatically resize large images
    max_width: 1920  # Maximum width in pixels
    max_height: 1080  # Maximum height in pixels
    max_file_size_mb: 10  # Maximum file size in MB
    jpeg_quality: 85  # JPEG quality (1-100). 85 gives ~8k tokens, good for text
 
# API Providers
providers:
  lm-studio:
    name: "lm-studio"
    base_url: "http://192.168.3.2:1234/v1"
    api_key: "lm-studio"
    timeout: 300
    max_retries: 3
  
  openrouter:
    name: "openrouter"
    base_url: "https://openrouter.ai/api/v1"
    api_key_env: "OPENROUTER_API_KEY"
    timeout: 300
    max_retries: 3
    streaming_enabled: true



# Models
models:
  gemini-3-pro:
    name: "google/gemini-3-pro-preview"
    provider: "openrouter"
    temperature: 0.3
    max_tokens: 8000
    description: "Gemini 3 pro model"
    streaming_enabled: true

  openai-oss-20b:
    name: "openai/gpt-oss-20b"
    provider: "openrouter"
    temperature: 0.7
    max_tokens: 8192
    description: "OpenAI OSS 20b model"
    streaming_enabled: false
  
  openai-oss-20b-local:
    name: "openai/gpt-oss-20b"
    provider: "lm-studio"
    temperature: 0.7
    max_tokens: 8192
    description: "OpenAI OSS 20b model"
    streaming_enabled: true

  openai-oss-120b:
    name: "openai/gpt-oss-120b"
    provider: "openrouter"
    temperature: 0.7
    max_tokens: 8192
    description: "OpenAI OSS 120b model"

  gpt-5-nano:
    name: "openai/gpt-5-nano"
    provider: "openrouter"
    temperature: 0.7
    max_tokens: 2000
    description: "GPT-5 nano model"
    streaming_enabled: true

  qwen3-8b:
    name: "qwen/qwen3-8b"
    provider: "lm-studio"
    temperature: 0.7
    max_tokens: 8000
    description: "Qwen 3 8b model"

  qwen3-max:
    name: "qwen/qwen3-max"
    provider: "openrouter"
    temperature: 0.7
    max_tokens: 8000
    description: "Qwen 3 Max model"
    streaming_enabled: true



# Minimal checker section (for output guardrail audit)
checkers:
  default_audit:
    model: "qwen3"   # optional for future extension; currently not invoked
    purpose: "output_audit"
    prompt: |
      You are a checker agent. You are provided with the agent's task context, agent output, and list of tools used.
      Verify that the agent uses the optimal tool for the task and that its actions align with the context and task goal.
      Input: one line JSON with fields task_text, tools_used, agent_output.
      Return strictly JSON: {"status":"ok|failed","reason":"...", "details":"..."}.
    tool_prompt: |
      You are a tool call checker agent. Assess whether the tool call is correct given the task goal.
      Do not block access-checking tool calls.
      Input: JSON {task_text, tools_used, tool_name, tool_arguments}.
      Return strictly JSON: {"status":"ok|failed","reason":"...","details":"..."}.

# Tools
tools:
  # MCP servers
  # Terminal - simple and stable MCP server  
  terminal:
    type: "mcp"
    server_command: ["'c:/Program Files/nodejs/npx.cmd'", "@dillip285/mcp-terminal", "--", "C:/Users/daniil/Documents/agents"]
    description: "MCP server for executing terminal commands"
    prompt_addition: "Use execute_command to run terminal commands."
  
  # File system
  filesystem:
    type: "mcp"
    server_command: ["'c:/Program Files/nodejs/npx.cmd'", "@modelcontextprotocol/server-filesystem", "C:/Users/daniil/Documents/agents"]
    description: "MCP server for filesystem operations (restricted to working directory)"
    prompt_addition: "Use filesystem(task) to access the filesystem. task is the operation to perform."
  
  git:
    type: "mcp"
    server_command: ["c:/Program Files/nodejs/npx.cmd", "@cyanheads/git-mcp-server", "C:/Users/daniil/Documents/agents"]
    env_vars:
      MCP_LOG_LEVEL: "info"
      GIT_SIGN_COMMITS: "false"
    description: "Git management: clone, commit, branch, merge, rebase, stash"

  sequentialthinking:
    type: "mcp"
    server_command: ['c:/Program Files/nodejs/npx.cmd', "@modelcontextprotocol/server-sequential-thinking"]
    description: "MCP server for sequential thinking"
    prompt_addition: "IMPORTANT!!! ALWAYS use sequential thinking for analysis and task planning. Call it before performing any task."
  
  
  # Agents as tools
  file_agent:
    type: "agent"
    name: "call_file_agent"
    description: "Calls the file agent for file operations"
    prompt_addition: "Use call_file_agent(task) for file-related tasks, where task is the task the file agent should perform. Use unified diff for file editing."
    # Context sharing configuration for agent tools
    context_strategy: "conversation"
    context_depth: 5
    include_tool_history: true
   
  git_agent:
    type: "agent"
    name: "call_git_agent"
    description: "Calls the Git agent for repository work. Call when a Git operation is needed."
    prompt_addition: "Use call_git_agent(task) for Git operations. task is the task the Git agent should perform."
    # Context sharing configuration for agent tools
    context_strategy: "conversation"
    context_depth: 5
    include_tool_history: false
  
  task_analyst:
    type: "agent"
    name: "call_task_analyst"
    description: "Calls the task analyst for task analysis and action planning."
    prompt_addition: "ALWAYS CALL call_task_analyst(task) for help in creating an action plan. task is the task to solve with full context and a list of available tools. WITHOUT FULL CONTEXT AND TOOL LIST THE ANALYST CANNOT HELP!!! DO NOT call other tools before calling the analyst."
    # Context sharing configuration for agent tools
    context_strategy: "full"
    

  researcher:
    type: "agent"
    name: "call_researcher"
    description: "Calls the researcher to search for information"
    prompt_addition: "Use call_researcher(query) to search for information online. query is the research topic."
    # Context sharing configuration for agent tools
    context_strategy: "minimal"
    context_depth: 3
    include_tool_history: false
  
  code_agent:
    type: "agent"
    name: "call_code_agent"
    description: "Calls the code agent for coding and programming tasks"
    prompt_addition: "Always use call_code_agent(task) for tasks related to code or code files. task is the task the code agent should solve with the file path, directory, or repository and a detailed task description."
    # Context sharing configuration for agent tools
    context_strategy: "conversation"
    context_depth: 10
    include_tool_history: true
  
  coordinator:
    type: "agent"
    name: "call_coordinator"
    description: "Calls the coordinator for planning and solving tasks"
    prompt_addition: |
      Call call_coordinator(task) for planning and solving tasks. 
      task is the task to solve.
    # Context sharing configuration for agent tools
    context_strategy: "conversation"
    context_depth: 10
    include_tool_history: true
    verifier: "default_audit"
  
  context_wrapper:
    type: "agent"
    name: "call_context_wrapper"
    description: "Calls the context collector for context management and agent interaction"
    prompt_addition: "Use call_context_wrapper(task) to get codebase context. task is the task requiring context."
    context_strategy: "conversation"
    context_depth: 10
    include_tool_history: true
    verifier: "default_audit"

  debugger:
    type: "agent"
    name: "call_debugger"
    description: "Calls the debugger for code debugging"
    prompt_addition: "Use call_debugger(task) for running programs and debugging code."
    context_strategy: "conversation"
    context_depth: 10
    include_tool_history: true

  thinker:
    type: "agent"
    name: "call_thinker"
    description: "Calls the thinking agent for deep task and problem analysis."
    prompt_addition: "ALWAYS call this agent BEFORE performing any task. Use call_thinker(task), where task is the task to solve with full context. WITHOUT FULL CONTEXT THE THINKER CANNOT HELP!!! DO NOT call other tools before calling the thinker."

# Base prompt templates for tools
prompt_templates:
  context_wrapper_prompt: |
    You are an agent for extracting context from the codebase. Other agents contact you to get context for tasks.
    Your job is to gather context from files and git.
    Use tools to extract information.

  task_analyst_prompt: |
    You are a task analyst. Your job is to analyze tasks and create action plans.
    Always use the full task context, including files and repositories.
    Do not start executing the task before calling the code agent or file agent.
    Do not use specific commands or attempt to execute them.

  base: |
    You are an AI assistant. Respond in the user's language.
    Be helpful and accurate in your answers.
  
  with_files: |
    You are an agent with file tools. You can read, edit, and analyze files.
    NEVER PROVIDE CONTENT ANALYSIS, EVEN IF SPECIFIED IN THE TASK.

  with_git: |
    You are an agent with Git tools. You can check status, create commits, and manage the repository.
    Always check status before making changes. Analyze the task, create an action plan, and follow it, adjusting as needed.
  
  with_web: |
    You are an assistant with internet access. You can search for current information and news.
    Always cite your sources.

  code_agent_prompt: |
    You are a code agent specializing in programming.

  coordinator_prompt: |
    You are a coordinator of a team of specialized agents in an agent system. 
    Your job is to analyze user or agent requests and delegate work to appropriate agents or use tools to efficiently and effectively solve the task.
    You explicitly specify reporting requirements for the agents you call. Report formats depend on the task; think about agent work validation first to give them the right report format.

  orchestrator_prompt: |
    You are an orchestrator of a team of specialized agents. After receiving a request you:
    1. Ask the coordinator about available tools and agents.
    2. Think through a plan to solve the task with the available tools.
    3. If tools and agents are sufficient for the task, pass the plan to the coordinator.

  debugger_prompt: |
    You are a debugger. Your job is to debug code and perform tasks related to running programs. 
    Before each step and tool call, use sequential thinking for analysis and planning.

# Agents - full configuration
agents:
  # Git agent
  git_agent:
    name: "Git Agent"
    model: "openai-oss-20b-local"
    tools: ["git", "filesystem"]
    base_prompt: "with_git"
    description: "Full-featured developer assistant for Git"
    verifier: "default_audit"
  
  context_wrapper:
    name: "Context Collector"
    model: "openai-oss-20b-local"
    tools: ["filesystem", "git"]
    base_prompt: "context_wrapper_prompt"
    description: "Wrapper for context management and agent interaction"
    verifier: "default_audit"

  code_agent:
    name: "Code Agent"
    model: "gemini-3-pro"
    tools: [
      "filesystem", "git", "terminal"
    ]
    base_prompt: "code_agent_prompt"
    description: "Programming and code analysis specialist"
    mcp_enabled: true
    verifier: "default_audit"
  
  # Thinking agent
  thinker:
    name: "Thinker"
    model: "openai-oss-20b-local"
    tools: []
    base_prompt: "base"
    custom_prompt: |
      You are a deep-thinking assistant. Analyze problems from all angles.
      Reason step by step and provide comprehensive justifications for your conclusions.
      You are given a problem to solve and the operations available to solve the task.
    description: "Agent for deep analysis and reasoning"
  
  task_analyst:
    name: "Task Analyst"
    model: "openai-oss-20b-local"
    tools: []
    base_prompt: "task_analyst_prompt"
    description: "Agent for task analysis and action planning"

  debugger:
    name: "Debugger"
    model: "openai-oss-20b-local"
    tools: ["terminal", "filesystem", "git"]
    base_prompt: "debugger_prompt"
    description: "Agent for code debugging"

  # Agent coordinator
  coordinator:
    name: "Coordinator"
    model: "gemini-3-pro"
    tools: ["filesystem", "git_agent","code_agent", "debugger", "file_agent"]
    base_prompt: "coordinator_prompt"
    verifier: "default_audit"
    custom_prompt: |
      You are a coordinator of a team of specialized agents. 
      Your job is effective role distribution and context management. 
      You receive a task, gather or refine context as needed, think through an effective solution, and delegate work to appropriate agents.
      You can manage agent context by specifying a Context ID at the beginning of your request to an agent. Without a Context ID, the agent won't remember your previous interactions.
      After receiving each request, you think about:
      1. Which agents to use.
      2. Direction of agent actions.
      3. Whether to use the previous ID so the agent remembers your interactions, or start fresh.

  orchestrator:
    name: "Orchestrator"
    model: "qwen3-max"
    tools: ["coordinator"]
    base_prompt: "orchestrator_prompt"
    verifier: "default_audit"
    custom_prompt: |
      You are an orchestrator of a team of specialized agents. After receiving a request you:
      1. Ask the coordinator about available tools and agents.
      2. Think through a plan to solve the task with the available tools.
      3. If tools and agents are sufficient for the task, pass the plan to the coordinator.

  # Vision agent for image analysis
  vision_analyzer:
    name: "Visual Analyst"
    model: "gemini-3-pro"
    tools: []
    base_prompt: "base"
    description: "Agent for image and screenshot analysis"
    custom_prompt: |
      You are a specialist in image and visual content analysis.
      You can describe what you see in images, read text, analyze graphs, diagrams, and interfaces.
      Answer in detail and in a structured manner.
      If the image contains text — be sure to read it and quote important parts.

  file_agent:
    name: "File Agent"
    model: "gpt-5-nano"
    tools: ["filesystem"]
    base_prompt: "with_files"
    description: "File operations specialist."
    mcp_enabled: true

# =============================================================================
# COMPACT SYSTEM CONFIGURATION
# =============================================================================
# Controls context management and compaction to manage token limits.
# Inspired by Claude Code's compact system.

compact:
  enabled: true

  # Session memory compact - LLM-based summarization
  session_memory:
    enabled: true
    min_tokens: 10000        # Minimum tokens to preserve after compact
    max_tokens: 40000        # Maximum tokens after compact
    trigger_threshold: 0.75 # Trigger compact at 75% of context window
  
  # Microcompact - tool result clearing for token efficiency
  micro:
    enabled: true
    max_age_hours: 1.0      # Clear tool results older than 1 hour
    gap_threshold_minutes: 60.0
    preserve_last_n: 5       # Keep last N tool results
    compactable_tools:       # Tools whose results can be cleared
      - read_file
      - read_text_file
      - read_media_file
      - list_directory
      - list_directory_with_sizes
      - directory_tree
      - search_files
      - execute_command
      - web_fetch
      - web_search
      - git_diff
      - git_log
  
  # Auto-compact trigger - automatic compaction on threshold
  auto:
    enabled: true
    buffer_tokens: 13000           # Tokens to keep as buffer before limit
    warning_buffer_tokens: 20000   # Tokens for warning threshold
    error_buffer_tokens: 20000
    manual_buffer_tokens: 3000
    max_output_tokens_for_summary: 20000
    max_consecutive_failures: 3    # Circuit breaker for failures
  
  # Post-compact restoration - restore important context
  restore:
    files:
      enabled: true
      max_files: 5
      max_tokens_per_file: 5000
      token_budget: 50000
    skills:
      enabled: true
      token_budget: 25000
      max_tokens_per_skill: 5000

  # Optional: force compaction to use a dedicated model key from `models:`
  # summary_model: "gpt-5-nano"
  summary_max_output_tokens: 20000
