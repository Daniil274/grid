# systemd unit for a Grid web chat with accounts.
#
# Paths assume Grid in /opt/grid (with its .venv and .env) and the server's
# data - accounts and user spaces - in /var/lib/grid-web. With --accounts every
# user's agents run in a container of their own, from the sandbox image
# (`docker build -t grid-agent:latest docker/agent`, or isolation.image in the
# config). Starting those containers needs the Docker daemon, and membership in
# the docker group is as good as root on this machine - run Grid on a host or
# VM dedicated to it.
#
# Install the two slices next to this unit first:
#   install -m 644 deploy/grid-server.slice deploy/grid-users.slice /etc/systemd/system/

[Unit]
Description=Grid web chat (accounts)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=grid
Group=grid
SupplementaryGroups=docker
WorkingDirectory=/opt/grid
EnvironmentFile=/opt/grid/.env
# The server in its own slice, every container it starts in another
# (deploy/grid-server.slice, deploy/grid-users.slice): the users' commands
# together cannot take the CPU or memory the chat needs to answer.
Slice=grid-server.slice
Environment=GRID_CGROUP_PARENT=grid-users.slice
ExecStart=/opt/grid/.venv/bin/grid-web-chat --accounts \
    --routing deploy/routing.yaml \
    --data-dir /var/lib/grid-web \
    --host 127.0.0.1 --port 8000 \
    --secure-cookies
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/grid-web /opt/grid

[Install]
WantedBy=multi-user.target
