# Claude Tools Example Environment Variables
# Copy this file to .env and add your actual API keys

# =============================================================================
# REQUIRED: OpenCode API key for config.opencode.yaml
# =============================================================================
# Get your key from the OpenCode Zen dashboard.
OPENCODE_API_KEY=your_opencode_key_here

# OpenRouter key for the original config.yaml, if you still use it.
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# =============================================================================
# OPTIONAL: Firecrawl API for Web Search and JS rendering
# Get your key at: https://firecrawl.dev (500 free credits)
# =============================================================================
# FIRECRAWL_API_KEY=fc-your_firecrawl_key_here

# =============================================================================
# OPTIONAL: Custom Todo File Location
# Default: ~/.claude_tools_todos.json
# =============================================================================
# CLAUDE_TODO_FILE=/path/to/your/todos.json

# =============================================================================
# OPTIONAL: Proxy Configuration
# =============================================================================
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809
# ALL_PROXY=socks5://127.0.0.1:10808
# NO_PROXY=127.0.0.1,localhost
